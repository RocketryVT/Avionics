{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach Active Drag System (SWD)",
            "type": "cortex-debug",
            "request": "attach",
            "postAttachCommands": [
                // "continue"
            ],
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/src/active_drag_system.elf",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "searchDir": [],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "overrideAttachCommands": [
                "continue",
                "set remote hardware-breakpoint-limit 4"
                // "monitor halt",
                // "monitor resume""runToEntryPoint": "main",
            ],
            "svdFile": "${env:PICO_SDK_PATH}/src/rp2350/hardware_regs/rp2350.svd",
            "toolchainPrefix": "arm-none-eabi",
            "gdbPath": "/bin/arm-none-eabi-gdb",
            // "postLaunchCommands": [
			// 	"interrupt",
			// 	"start",
			// 	"load",
			// 	"starti"
            // ]

        }
    ]
}